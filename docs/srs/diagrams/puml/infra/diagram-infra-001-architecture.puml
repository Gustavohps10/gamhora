@startuml Architecture
title GAMHORA - Arquitetura Local-First e Addons SDK

node "Client Desktop (Electron)" {
    component "Renderer UI (React / Tailwind v4)" as UI
    component "Timer Service & IPC Bridge" as MainTimer
    component "Addon Loader & Registry" as AddonLoader
    database "Persistência Local (RxDB / SQLite / settings.json)" as DB
    component "Native Floating Widget" as Widget
}

node "Addon Ecosystem (@gamhora-org/sdk)" {
    [DataSources (Redmine, Jira...)] as DS
    [Themes (CSS Injected)] as Themes
    [Watchers (Window, Git, Idle)] as Watchers
    [Timerbar & Sidebar Menus] as Menus
}

node "External Tools (Direct Connection)" {
    [Redmine On-Premise] as RedmineServer
    [Jira Cloud / Server] as JiraServer
}

UI <-> MainTimer : IPC (timer:start / timer:tick)
UI <-> DB : Leitura/Escrita Local
MainTimer <-> Widget : Eventos IPC de Sincronia
UI <-> AddonLoader : Ativação / Execução de Ações
AddonLoader --> DS : Registra
AddonLoader --> Themes : Injeta no DOM
AddonLoader --> Watchers : Monitora Background
AddonLoader --> Menus : Registra Menus

DS <--> RedmineServer : Chamadas REST Diretas (Sem intermediários)
DS <--> JiraServer : Chamadas REST Diretas (Sem intermediários)
@enduml
