@startuml ClassLicensePlan
title PANDHORA - Modelo de Licenciamento Local (Free vs Pro)
package "Core Licensing" {
    class LicenseInfo {
        +String key
        +PlanType plan
        +Boolean isValid
        +DateTime expiresAt
        +String[] activeFeatures
    }
    
    enum PlanType {
        free
        pro
    }

    class ProFeatures {
        +multiWorkspaces: Boolean
        +multiDataSources: Boolean
        +windowObserver: Boolean
        +gitTracker: Boolean
        +idleResolver: Boolean
        +autoSuggestor: Boolean
        +dailyGenerator: Boolean
        +customThemes: Boolean
    }
}
LicenseInfo ..> PlanType : plan
LicenseInfo ..> ProFeatures : unlocks
@enduml
