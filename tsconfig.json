{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@pandhora/application": ["src/packages/application/src"],
      "@pandhora/application/*": ["src/packages/application/src/*"],

      "@pandhora/adapters": ["src/packages/adapters/src"],
      "@pandhora/adapters/*": ["src/packages/adapters/src/*"],

      "@pandhora/shared": ["src/packages/shared/src"],
      "@pandhora/shared/*": ["src/packages/shared/src/*"],

      "@pandhora/domain": ["src/packages/domain/src"],
      "@pandhora/domain/*": ["src/packages/domain/src/*"],

      "@pandhora/sdk": ["src/apps/sdk/src"],
      "@pandhora/sdk/*": ["src/apps/sdk/src/*"],

      "@pandhora/ui": ["src/packages/ui/src"],
      "@pandhora/ui/*": ["src/packages/ui/src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vitest.setup.ts",
    "mocks/**/*.ts"
  ]
}